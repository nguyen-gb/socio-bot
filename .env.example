NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api
DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

DATABASE_URL=postgresql://socio:socio@localhost:5432/socio?schema=public
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=browser-automation
WORKER_NAME=local-browser-worker
WORKER_VERSION=0.1.0

# At least 32 random characters outside development.
CONTROL_API_KEY=replace-with-a-long-random-control-api-key
REMOTE_SESSION_SECRET=replace-with-an-independent-32-character-secret
ACCESS_TOKEN_SECRET=replace-with-an-independent-32-character-secret
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

PROFILE_ROOT=./profiles
ARTIFACT_ROOT=./artifacts
# Local encrypted storage is the safe default. Set s3 explicitly only for an approved bucket.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_ROOT=./object-storage
SECRET_ROOT=./secrets
# Encrypts browser snapshots and submitted account/proxy credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROFILE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Campaign/automation mode follows NODE_ENV by default:
# development = headed (false), production = headless (true).
# Set BROWSER_HEADLESS=false for a local worker that should use a visible,
# manually-like Chrome window. Interactive Profiles sessions use the same mode.
# Optional installed Chrome-compatible channel. Production deployments use the
# branded Google Chrome binary in headless mode; local/staging can override this.
# BROWSER_CHANNEL=chrome
# Keep Playwright's defaults, or use the branded Chrome launch switches for a
# regular Chrome-like browser surface without changing UA/device metrics.
# BROWSER_AUTOMATION_MODE=chrome
# BROWSER_HEADLESS=true
# Optional normal-browser locale/timezone. Leave unset to use the host defaults.
# BROWSER_LOCALE=en-US
# BROWSER_TIMEZONE_ID=Asia/Ho_Chi_Minh
# Optional AntiCaptcha.top integration. It is disabled unless explicitly enabled.
# ANTICAPTCHA_API_KEY=
# ANTICAPTCHA_AUTO_SOLVE=false
# ANTICAPTCHA_API_URL=https://anticaptcha.top/api/captcha
# ANTICAPTCHA_RECOGNITION_URL=https://anticaptcha.top/in.php
# ANTICAPTCHA_RESULT_URL=https://anticaptcha.top/res.php
# ANTICAPTCHA_API_TRANSPORT=json
# ANTICAPTCHA_TIMEOUT_MS=120000
# ANTICAPTCHA_TIKTOK_ROTATE_INVERT=false
# ANTICAPTCHA_TIKTOK_ROTATE_MODE=degrees
# TikTok Search mode. Keep live in production; fixture avoids external TikTok
# traffic for deterministic product/workflow tests and never bypasses CAPTCHA.
TIKTOK_SEARCH_MODE=live
# success | empty | challenge (used only when TIKTOK_SEARCH_MODE=fixture)
TIKTOK_SEARCH_FIXTURE_SCENARIO=success
BROWSER_MAX_SLOTS=4
BROWSER_IDLE_TTL_MS=300000
PROFILE_LEASE_TTL_MS=1200000
REMOTE_SESSION_PORT=3010
REMOTE_SESSION_PUBLIC_URL=ws://localhost:3010
REMOTE_SESSION_REDIS_RELAY=false
# Keep false in production unless private proxy endpoints are explicitly trusted.
ALLOW_PRIVATE_PROXY_HOSTS=false

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=socio-assets
S3_ACCESS_KEY=socio
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
